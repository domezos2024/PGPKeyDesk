<Window x:Class="AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Profile" Height="680" Width="520"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BaseBg}"
        Foreground="{StaticResource TextPrimary}"
        Icon="1a.png">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="New Profile" FontSize="20" FontWeight="Bold"
                   Foreground="#CDD6F4" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Profile Name" Style="{StaticResource Label}"/>
            <Grid>
                <TextBox x:Name="TxtName" Style="{StaticResource Input}"
                         TextChanged="TxtName_TextChanged"/>
                <TextBlock x:Name="HintName" Text="e.g. Work Key, Personal Key"
                           Foreground="#45475A" FontSize="13" Padding="9,7"
                           IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Private Key (.asc)" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F4C2; Load File"
                    Style="{StaticResource ChipBtn}"
                    Click="BrowsePrivateKey_Click"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <TextBox x:Name="TxtPrivateKey"
                     Style="{StaticResource Input}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextChanged="TxtPrivateKey_TextChanged"/>
            <TextBlock x:Name="HintPrivateKey"
                       Text="-----BEGIN PGP PRIVATE KEY BLOCK-----&#x0a;...&#x0a;-----END PGP PRIVATE KEY BLOCK-----"
                       Foreground="#45475A" FontFamily="Consolas" FontSize="11"
                       Padding="9,7" IsHitTestVisible="False" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="TxtPrivateKeyStatus" Grid.Row="4"
                   FontSize="11" FontFamily="Consolas"
                   Margin="2,0,0,8" Visibility="Collapsed"
                   TextWrapping="Wrap"/>
        <Grid Grid.Row="5" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Public Key (.asc)" Style="{StaticResource Label}" Margin="0"/>
                <TextBlock Text=" — optional" Foreground="#6C7086" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="&#x1F4C2; Load File"
                    Style="{StaticResource ChipBtn}"
                    Click="BrowsePublicKey_Click"/>
        </Grid>
        <Grid Grid.Row="6" Margin="0,0,0,6">
            <TextBox x:Name="TxtPublicKey"
                     Style="{StaticResource Input}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     TextChanged="TxtPublicKey_TextChanged"/>
            <TextBlock x:Name="HintPublicKey"
                       Text="-----BEGIN PGP PUBLIC KEY BLOCK-----&#x0a;...&#x0a;-----END PGP PUBLIC KEY BLOCK-----"
                       Foreground="#45475A" FontFamily="Consolas" FontSize="11"
                       Padding="9,7" IsHitTestVisible="False" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="TxtPublicKeyStatus" Grid.Row="7"
                   FontSize="11" FontFamily="Consolas"
                   Margin="2,0,0,0" Visibility="Collapsed"
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                    Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Save Profile" Style="{StaticResource PrimaryBtn}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
