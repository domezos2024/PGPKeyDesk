<UserControl x:Class="FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,8,0">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="File" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Content="&#x1F4C2; Browse" Style="{StaticResource QuietSidebarBtn}"
                        Padding="12,5" Click="Browse_Click"/>
            </Grid>
            <TextBox x:Name="TxtFile" Style="{StaticResource Input}" FontFamily="Consolas" FontSize="12"
                     TextChanged="Inputs_Changed"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Recipient (encrypt) / signer key (verify)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="&#x1F511; Keyring" Style="{StaticResource QuietSidebarBtn}" Padding="12,5"
                                Click="PickRecipient_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtRecipient" Text="none selected" Foreground="#6C7086"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sender key (verify signature when decrypting)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="&#x1F58A; Keyring" Style="{StaticResource QuietSidebarBtn}" Padding="12,5"
                                Click="PickSender_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSender" Text="none (signature not checked)" Foreground="#6C7086"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Passphrase of the active profile (decrypt, sign, sign+encrypt)" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PwdFile" Style="{StaticResource PasswordInput}"/>
            </StackPanel>
            <CheckBox x:Name="ChkArmor" Content="ASCII armor output (text-safe, ~33% larger)" Margin="0,12,0,0"
                      Foreground="#A6ADC8"/>
            <CheckBox x:Name="ChkSign" Content="Also sign with active profile (encrypt)" Margin="0,6,0,0"
                      Foreground="#A6ADC8"/>

            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="BtnEncryptFile" Content="&#x1F510;  Encrypt" Style="{StaticResource EncryptBtn}"
                        Margin="0,0,8,8" IsEnabled="False" Click="EncryptFile_Click"/>
                <Button x:Name="BtnDecryptFile" Content="&#x1F513;  Decrypt" Style="{StaticResource PrimaryBtn}"
                        Margin="0,0,8,8" IsEnabled="False" Click="DecryptFile_Click"/>
                <Button x:Name="BtnSignFile" Content="&#x1F58A;  Sign" Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,8,8" IsEnabled="False" Click="SignFile_Click"/>
                <Button x:Name="BtnVerifyFile" Content="&#x2714;  Verify Signature" Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,8,8" IsEnabled="False" Click="VerifyFile_Click"/>
            </WrapPanel>

            <Border Background="#313244" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"
                    Padding="12,10" Margin="0,8,0,0">
                <TextBlock x:Name="TxtFileResult" TextWrapping="Wrap" FontSize="13" Foreground="#6C7086"
                           Text="Choose a file, then encrypt, decrypt, sign or verify it. Files up to 200 MB."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
