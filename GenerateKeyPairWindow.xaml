<Window x:Class="GenerateKeyPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Key Pair"
        Height="600" Width="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BaseBg}"
        Foreground="{StaticResource TextPrimary}"
        Icon="1a.png">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="&#x2699; Generate New Key Pair"
                       FontSize="20" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,20"/>
            <TextBlock Text="Profile Name" Style="{StaticResource Label}"/>
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="TxtProfileName" Style="{StaticResource Input}"
                         TextChanged="TxtProfileName_Changed"/>
                <TextBlock x:Name="HintProfileName" Text="e.g. My Main Key"
                           Foreground="#45475A" FontSize="13" Padding="9,7"
                           IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="Name / Email (Key Identity)" Style="{StaticResource Label}"/>
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="TxtIdentity" Style="{StaticResource Input}"
                         TextChanged="TxtIdentity_Changed"/>
                <TextBlock x:Name="HintIdentity"
                           Text="e.g. John Doe &lt;john@example.com&gt;"
                           Foreground="#45475A" FontSize="13" Padding="9,7"
                           IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="Passphrase" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="PwdPassphrase" Style="{StaticResource PasswordInput}"
                         Margin="0,0,0,14"/>
            <TextBlock Text="Confirm Passphrase" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="PwdConfirm" Style="{StaticResource PasswordInput}"
                         Margin="0,0,0,16"/>
            <TextBlock Text="Key Strength" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,20">
                <RadioButton x:Name="Rb2048" Content="RSA 2048 Bit"
                             Foreground="#CDD6F4" FontSize="13"
                             VerticalContentAlignment="Center" Margin="0,0,24,0"/>
                <RadioButton x:Name="Rb4096" Content="RSA 4096 Bit  (recommended)"
                             Foreground="#CDD6F4" FontSize="13"
                             IsChecked="True"
                             VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button x:Name="BtnGenerate"
                    Content="&#x2699;  Generate Key Pair"
                    Style="{StaticResource GenerateActionBtn}"
                    HorizontalAlignment="Stretch"
                    Click="BtnGenerate_Click"/>
            <Border x:Name="ResultPanel" Visibility="Collapsed"
                    Style="{StaticResource RevealPanel}"
                    Background="#181825" CornerRadius="8"
                    Padding="16" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#x2714;" Foreground="#A6E3A1" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Key pair generated successfully!"
                                   Foreground="#A6E3A1" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Public Key" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#x1F4CB; Copy" Style="{StaticResource ChipBtn}"
                                    Click="BtnCopyPublicKey_Click"/>
                            <Button Content="&#x1F4BE; Export" Style="{StaticResource ChipBtn}"
                                    Margin="6,0,0,0"
                                    Click="BtnExportPublicKey_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtPublicKeyResult"
                             Background="#313244" Foreground="#89DCEB"
                             BorderBrush="#45475A" BorderThickness="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10"
                             Height="75" Padding="8,6"
                             Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Private Key" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#x1F4CB; Copy" Style="{StaticResource ChipBtn}"
                                    Click="BtnCopyPrivateKey_Click"/>
                            <Button Content="&#x1F4BE; Export" Style="{StaticResource ChipBtn}"
                                    Margin="6,0,0,0"
                                    Click="BtnExportPrivateKey_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtPrivateKeyResult"
                             Background="#313244" Foreground="#F38BA8"
                             BorderBrush="#45475A" BorderThickness="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10"
                             Height="75" Padding="8,6"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,4">
                <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                        Click="BtnCancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSave"
                        Content="Save as Profile"
                        Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
