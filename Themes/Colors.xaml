<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BaseBg" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="MantleBg" Color="#181825"/>
    <SolidColorBrush x:Key="Surface0" Color="#313244"/>
    <SolidColorBrush x:Key="Surface1" Color="#45475A"/>
    <SolidColorBrush x:Key="Surface2" Color="#585B70"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#6C7086"/>
    <SolidColorBrush x:Key="TextHint" Color="#45475A"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBlue" Color="#89B4FA"/>
    <SolidColorBrush x:Key="AccentBlueHover" Color="#B4D0FF"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="AccentGreenHover" Color="#C3F5BE"/>
    <SolidColorBrush x:Key="AccentRed" Color="#F38BA8"/>
    <SolidColorBrush x:Key="AccentRedHoverBg" Color="#3D1C26"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F9E2AF"/>
    <SolidColorBrush x:Key="AccentYellowHover" Color="#FAE9BE"/>
    <SolidColorBrush x:Key="AccentTeal" Color="#89DCEB"/>

    <!-- Status -->
    <SolidColorBrush x:Key="WarningBg" Color="#3D2A1A"/>

</ResourceDictionary>
