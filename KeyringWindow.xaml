<Window x:Class="KeyringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipient Keyring" Height="640" Width="620"
        MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBg}"
        Foreground="{StaticResource TextPrimary}"
        Icon="1a.png">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Recipient Keyring" FontSize="20" FontWeight="Bold"
                   Foreground="#CDD6F4" Margin="0,0,0,12"/>
        <ListBox Grid.Row="1" x:Name="KeyList" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource ProfileItem}"
                 SelectionChanged="KeyList_SelectionChanged"
                 MouseDoubleClick="KeyList_DoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <TextBlock Grid.Row="1" x:Name="TxtEmpty" Text="No recipient keys yet. Add one below."
                   Foreground="#45475A" FontSize="12" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Add public key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Content="&#x1F4C2; Load File" Style="{StaticResource ChipBtn}" Click="LoadFile_Click"/>
            </Grid>
            <TextBox x:Name="TxtName" Style="{StaticResource Input}" Margin="0,0,0,6"
                     ToolTip="Display name (optional, defaults to the key's user ID)"/>
            <TextBox x:Name="TxtKey" Style="{StaticResource InputBox}" Height="90"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextChanged="TxtKey_Changed"/>
            <TextBlock x:Name="TxtKeyStatus" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="TxtMessage" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnAdd" Content="Add to Keyring" IsEnabled="False"
                    Style="{StaticResource PrimaryBtn}" Click="Add_Click"/>
            <Button Grid.Column="1" x:Name="BtnRemove" Content="Remove" IsEnabled="False"
                    Style="{StaticResource DangerBtn}" Margin="8,0,0,0" Click="Remove_Click"/>
            <Button Grid.Column="3" x:Name="BtnSelect" Content="Use Selected" IsEnabled="False"
                    Style="{StaticResource EncryptBtn}" Visibility="Collapsed" Click="Select_Click"/>
            <Button Grid.Column="4" Content="Close" Style="{StaticResource QuietSidebarBtn}"
                    Margin="8,0,0,0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
